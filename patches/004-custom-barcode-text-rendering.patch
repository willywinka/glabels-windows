         const double MIN_POINT_SIZE = 0.4; // Less than ~0.37 causes issues for QFontMetricsF
+
+
+        int barcodeTextPixelSize( double pointSize )
+        {
+                const double virtualDpi = 72.0;
+                return qMax( 1,
+                             qRound( std::max( pointSize, MIN_POINT_SIZE ) *
+                                     virtualDpi / 72.0 ) );
+        }
+
