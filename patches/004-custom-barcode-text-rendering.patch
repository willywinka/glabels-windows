+
+        void renderBarcodeWithTextBand( QPainter*           painter,
+                                        glbarcode::Barcode* barcode,
+                                        Distance            targetW,
+                                        Distance            targetH,
+                                        bool                showText,
+                                        const QString&      fontFamily,
+                                        double              fontSize,
+                                        QFont::Weight       fontWeight,
+                                        bool                italic,
+                                        bool                underline,
+                                        Qt::Alignment       hAlign,
+                                        const QColor&       color )
+        {
+                if ( (targetW.pt() <= 0) || (targetH.pt() <= 0) )
+                {
+                        return;
+                }
+
+                QString text;
+                QFont font( fontFamily );
+                font.setPointSizeF( std::max( fontSize, MIN_POINT_SIZE ) );
+                font.setWeight( fontWeight );
+                font.setItalic( italic );
+                font.setUnderline( underline );
+
+                double textBandH = 0.0;
+                if ( showText )
+                {
+                        text = barcodeHumanReadableText( barcode );
+                        if ( !text.isEmpty() )
+                        {
+                                const QFontMetricsF fm( font );
+                                const double maxTextH = std::max( 0.0, targetH.pt() - 1.0 );
+                                textBandH = std::min( fm.height() + 2.0, maxTextH );
+                        }
+                }
+
+                const double barcodeH = targetH.pt() - textBandH;
+
+                if ( barcodeH > 0 )
+                {
+                        painter->save();
+                        painter->setClipRect( QRectF( 0, 0, targetW.pt(), barcodeH ) );
+                        renderBarcodeAtExactSize( painter,
+                                                  barcode,
+                                                  targetW,
+                                                  Distance::pt(barcodeH) );
+                        painter->restore();
+                }
+
+                if ( showText && !text.isEmpty() && (textBandH > 0) )
+                {
+                        const QRectF textRect( 0, barcodeH, targetW.pt(), textBandH );
+
+                        painter->save();
+                        painter->setClipRect( textRect );
+                        painter->setFont( font );
+                        painter->setPen( QPen( color ) );
+                        painter->drawText( textRect,
+                                           int(hAlign) | int(Qt::AlignVCenter) | int(Qt::TextSingleLine),
+                                           text );
+                        painter->restore();
+                }
+        }
 }
