+        class GraphicsYBoundsRenderer final : public glbarcode::Renderer
+        {
+        public:
+                bool hasGraphics() const
+                {
+                        return mHasGraphics;
+                }
+
+                double minY() const
+                {
+                        return mMinY;
+                }
+
+                double maxY() const
+                {
+                        return mMaxY;
+                }
+
+        private:
+                void extend( double top, double bottom )
+                {
+                        if ( !mHasGraphics )
+                        {
+                                mMinY = top;
+                                mMaxY = bottom;
+                                mHasGraphics = true;
+                        }
+                        else
+                        {
+                                mMinY = std::min( mMinY, top );
+                                mMaxY = std::max( mMaxY, bottom );
+                        }
+                }
+
+                void drawBegin( double, double ) override {}
+                void drawEnd() override {}
+
+                void drawLine( double, double y, double, double h ) override
+                {
+                        extend( y, y + h );
+                }
+
+                void drawBox( double, double y, double, double h ) override
+                {
+                        extend( y, y + h );
+                }
+
+                void drawText( double,
+                               double,
+                               double,
+                               const std::string&,
+                               glbarcode::HAlign ) override
+                {
+                }
+
+                void drawRing( double, double y, double r, double w ) override
+                {
+                        const double outerR = r + w/2.0;
+                        extend( y - outerR, y + outerR );
+                }
+
+                void drawHexagon( double, double y, double h ) override
+                {
+                        extend( y, y + h );
+                }
+
+                bool   mHasGraphics{ false };
+                double mMinY{ 0.0 };
+                double mMaxY{ 0.0 };
+        };
+
+
+        QString barcodeHumanReadableText( glbarcode::Barcode* barcode )
+        {
+                TextCaptureRenderer renderer;
+                barcode->render( renderer );
+                return renderer.text();
+        }
+
+
+        bool barcodeGraphicsYBounds( glbarcode::Barcode* barcode,
+                                     double&             minY,
+                                     double&             maxY )
+        {
+                GraphicsYBoundsRenderer renderer;
+                barcode->render( renderer );
+
+                if ( !renderer.hasGraphics() || (renderer.maxY() <= renderer.minY()) )
+                {
+                        return false;
+                }
+
+                minY = renderer.minY();
+                maxY = renderer.maxY();
+                return true;
+        }
