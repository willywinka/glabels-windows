+
+        QString barcodeHumanReadableText( glbarcode::Barcode* barcode )
+        {
+                TextCaptureRenderer renderer;
+                barcode->render( renderer );
+                return renderer.text();
+        }
+
+
+        void drawHumanReadableText( QPainter* painter,
+                                    const QString& text,
+                                    Distance targetW,
+                                    Distance targetH,
+                                    const QString& fontFamily,
+                                    double fontSize,
+                                    QFont::Weight fontWeight,
+                                    bool italic,
+                                    bool underline,
+                                    Qt::Alignment hAlign,
+                                    const QColor& color )
+        {
+                if ( text.isEmpty() || (targetW.pt() <= 0) || (targetH.pt() <= 0) )
+                {
+                        return;
+                }
+
+                QFont font( fontFamily );
+                font.setPointSizeF( std::max( fontSize, MIN_POINT_SIZE ) );
+                font.setWeight( fontWeight );
+                font.setItalic( italic );
+                font.setUnderline( underline );
+
+                const int flags = hAlign.toInt() | Qt::AlignBottom | Qt::TextSingleLine;
+
+                painter->save();
+                painter->setFont( font );
+                painter->setPen( QPen( color ) );
+                painter->drawText( QRectF( 0, 0, targetW.pt(), targetH.pt() ),
+                                   flags,
+                                   text );
+                painter->restore();
+        }
 
