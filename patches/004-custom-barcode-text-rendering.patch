+        void renderBarcodeWithTextBand( QPainter*           painter,
+                                        glbarcode::Barcode* barcode,
+                                        Distance            targetW,
+                                        Distance            targetH,
+                                        bool                showText,
+                                        const QString&      fontFamily,
+                                        double              fontSize,
+                                        QFont::Weight       fontWeight,
+                                        bool                italic,
+                                        bool                underline,
+                                        Qt::Alignment       hAlign,
+                                        const QColor&       color )
+        {
+                if ( (targetW.pt() <= 0) || (targetH.pt() <= 0) )
+                {
+                        return;
+                }
+
+                QString text;
+                if ( showText )
+                {
+                        text = barcodeHumanReadableText( barcode );
+                }
+
+                QFont font;
+                font.setFamily( fontFamily );
+                font.setPixelSize( barcodeTextPixelSize( fontSize ) );
+                font.setWeight( fontWeight );
+                font.setItalic( italic );
+                font.setUnderline( underline );
+
+                const double textGap = 1.0;
+                double textBandH = 0.0;
+
+                QFontMetricsF fontMetrics( font );
+                if ( showText && !text.isEmpty() )
+                {
+                        const double maxTextH =
+                                std::max( 0.0, targetH.pt() - textGap );
+                        textBandH =
+                                std::min( fontMetrics.lineSpacing(), maxTextH );
+                }
+
+                const double barcodeH =
+                        targetH.pt() - textBandH - ((textBandH > 0.0) ? textGap : 0.0);
+
+                if ( barcodeH > 0.0 )
+                {
+                        painter->save();
+                        painter->setClipRect( QRectF( 0, 0, targetW.pt(), barcodeH ) );
+                        renderBarcodeAtExactSize( painter,
+                                                  barcode,
+                                                  targetW,
+                                                  Distance::pt( barcodeH ) );
+                        painter->restore();
+                }
+
+                if ( showText && !text.isEmpty() && (textBandH > 0.0) )
+                {
+                        const double textTop = barcodeH + textGap;
+                        const QRectF textRect( 0, textTop, targetW.pt(), textBandH );
+
+                        QTextOption textOption;
+                        textOption.setAlignment( hAlign );
+                        textOption.setWrapMode( QTextOption::NoWrap );
+
+                        QTextLayout layout( text );
+                        layout.setFont( font );
+                        layout.setTextOption( textOption );
+                        layout.setCacheEnabled( true );
+
+                        layout.beginLayout();
+                        QTextLine line = layout.createLine();
+                        if ( line.isValid() )
+                        {
+                                line.setLineWidth( targetW.pt() );
+                                line.setPosition( QPointF( 0, 0 ) );
+                        }
+                        layout.endLayout();
+
+                        painter->save();
+                        painter->setClipRect( textRect );
+                        painter->setPen( QPen( color ) );
+                        layout.draw( painter, QPointF( 0, textTop ) );
+                        painter->restore();
+                }
+        }
 }
