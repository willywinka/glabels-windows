+        void renderBarcodeAtExactSize( QPainter*           painter,
+                                       glbarcode::Barcode* barcode,
+                                       Distance            targetW,
+                                       Distance            targetH )
+        {
+                const double sourceW = barcode->width();
+                const double sourceH = barcode->height();
+
+                if ( (sourceW <= 0) || (sourceH <= 0) ||
+                     (targetW.pt() <= 0) || (targetH.pt() <= 0) )
+                {
+                        return;
+                }
+
+                painter->save();
+                painter->scale( targetW.pt()/sourceW, targetH.pt()/sourceH );
+
+                glbarcode::QtRenderer renderer(painter);
+                barcode->render( renderer );
+
+                painter->restore();
+        }
