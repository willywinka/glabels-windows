+
+
+        void drawRasterImageWithoutReflectiveTransform( QPainter*      painter,
+                                                        const QRectF& destRect,
+                                                        const QImage& image,
+                                                        bool          normalizeReflection )
+        {
+                if ( !normalizeReflection )
+                {
+                        painter->drawImage( destRect, image );
+                        return;
+                }
+
+                /*
+                 * Keep raster reflections out of the painter transform.
+                 * Pre-mirror the pixels and cancel the object's reflection
+                 * locally. The visual result stays the same, while drawImage()
+                 * no longer depends on a reflective object transform.
+                 */
+                const QImage mirroredImage = image.mirrored( true, false );
+                painter->save();
+                painter->translate( destRect.left() + destRect.right(), 0.0 );
+                painter->scale( -1.0, 1.0 );
+                painter->drawImage( destRect, mirroredImage );
+                painter->restore();
+        }
 }
