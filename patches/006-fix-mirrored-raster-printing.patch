+        void drawRasterImageWithoutReflection( QPainter*      painter,
+                                               const QRectF& destRect,
+                                               const QImage& image,
+                                               bool          reflected )
+        {
+                if ( !reflected )
+                {
+                        painter->drawImage( destRect, image );
+                        return;
+                }
+
+                /*
+                 * ModelObject has already applied the object's reflective
+                 * matrix to painter. Factor one horizontal reflection out
+                 * of that matrix so drawImage() sees a positive-determinant
+                 * transform, and bake the same reflection into the pixels.
+                 */
+                const QImage mirroredImage = image.mirrored( true, false );
+                const QRectF mirroredRect( -destRect.right(),
+                                            destRect.top(),
+                                            destRect.width(),
+                                            destRect.height() );
+
+                painter->save();
+                painter->scale( -1.0, 1.0 );
+                painter->drawImage( mirroredRect, mirroredImage );
+                painter->restore();
+        }
+
 }
 
 
