         const Distance pad = Distance::pt(2);
+
+
+        void drawRasterImageWithoutReflectiveTransform( QPainter*      painter,
+                                                        const QRectF& destRect,
+                                                        const QImage& image,
+                                                        bool          normalizeReflection )
+        {
+                if ( !normalizeReflection )
+                {
+                        painter->drawImage( destRect, image );
+                        return;
+                }
+
+                /*
+                 * Some native Windows printer drivers do not reliably honor
+                 * reflective painter transforms for raster images.
+                 *
+                 * Keep the final appearance identical while making the
+                 * transform seen by drawImage() non-reflective: mirror the
+                 * pixels, then add one local horizontal reflection. The two
+                 * reflections cancel visually, but the combined painter
+                 * transform has a positive determinant.
+                 */
+                const QImage mirroredImage = image.mirrored( true, false );
+
+                painter->save();
+                painter->translate( destRect.left() + destRect.right(), 0.0 );
+                painter->scale( -1.0, 1.0 );
+                painter->drawImage( destRect, mirroredImage );
+                painter->restore();
+        }
 }
